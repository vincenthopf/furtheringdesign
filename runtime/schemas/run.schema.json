{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furthering.design/schemas/run.schema.json",
  "title": "Furthering Design Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "intent", "policy", "candidates", "pairwise"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string" },
    "intent": { "$ref": "intent.schema.json" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionWeights", "diversityFloor", "uncertaintyPenalty", "reviewMargin", "maxUncertainty", "hardGateSeverities"],
      "properties": {
        "selectionWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "pairwise", "diversity"],
          "properties": {
            "evidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "pairwise": { "type": "number", "minimum": 0, "maximum": 1 },
            "diversity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "diversityFloor": { "type": "number", "minimum": 0, "maximum": 1 },
        "uncertaintyPenalty": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewMargin": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxUncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
        "hardGateSeverities": { "type": "array", "minItems": 1, "items": { "enum": ["blocker", "major", "minor", "note"] }, "uniqueItems": true }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manifest", "evidence"],
        "properties": {
          "manifest": { "$ref": "candidate.schema.json" },
          "evidence": { "$ref": "evidence.schema.json" }
        }
      }
    },
    "pairwise": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["left", "right", "winner", "confidence", "rationale"],
        "properties": {
          "left": { "type": "string" },
          "right": { "type": "string" },
          "winner": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
