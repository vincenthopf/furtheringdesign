{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furthering.design/schemas/evidence.schema.json",
  "title": "Furthering Design Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "captures", "signals"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "candidateId": { "type": "string" },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["browser", "stateRef", "url", "viewport"],
        "properties": {
          "browser": { "enum": ["chromium", "firefox", "webkit", "other"] },
          "stateRef": { "type": "string" },
          "url": { "type": "string" },
          "viewport": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          },
          "screenshot": { "type": ["string", "null"] },
          "nodeMap": { "type": ["string", "null"] }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "dimension", "source", "status", "normalized", "confidence", "severity", "stateRef", "nodeRef", "evidence", "rationale", "recommendation"],
        "properties": {
          "id": { "type": "string" },
          "class": { "enum": ["A", "B", "C"] },
          "dimension": { "type": "string" },
          "source": { "type": "string" },
          "status": { "enum": ["pass", "fail", "unknown"] },
          "normalized": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "severity": { "enum": ["blocker", "major", "minor", "note"] },
          "stateRef": { "type": "string" },
          "nodeRef": { "type": "string" },
          "evidence": { "type": "string" },
          "rationale": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    }
  }
}
