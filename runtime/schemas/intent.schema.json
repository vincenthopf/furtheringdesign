{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furthering.design/schemas/intent.schema.json",
  "title": "Furthering Design Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "scope",
    "outcome",
    "audiences",
    "tasks",
    "brand",
    "experience",
    "success",
    "constraints",
    "freedoms",
    "states",
    "content",
    "risks",
    "assumptions",
    "openQuestions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "surface"
      ],
      "properties": {
        "level": {
          "enum": [
            "product",
            "flow",
            "page",
            "section",
            "component",
            "instance"
          ]
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "parentIntentId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "desiredChange",
        "antiGoals"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "desiredChange": {
          "type": "string",
          "minLength": 1
        },
        "antiGoals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "context",
          "needs",
          "anxieties",
          "capabilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "needs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "anxieties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/task"
        },
        "secondary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "voice",
        "distinctiveAssets",
        "referencePolicy"
      ],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "expression",
              "avoid"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "expression": {
                "type": "string"
              },
              "avoid": {
                "type": "string"
              }
            }
          }
        },
        "voice": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "distinctiveAssets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "referencePolicy": {
          "enum": [
            "abstract-principles-only",
            "licensed-assets",
            "original-only"
          ]
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emotionalRegister",
        "density",
        "familiarity",
        "motion",
        "hierarchy"
      ],
      "properties": {
        "emotionalRegister": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "density": {
          "type": "string"
        },
        "familiarity": {
          "type": "string"
        },
        "motion": {
          "type": "string"
        },
        "hierarchy": {
          "type": "string"
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria",
        "qualityProfile"
      ],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "signal",
              "direction",
              "target",
              "weight"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "signal": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "increase",
                  "decrease",
                  "hold",
                  "binary"
                ]
              },
              "target": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "qualityProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "weights",
            "floors",
            "uncertaintyPenalty"
          ],
          "properties": {
            "weights": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "floors": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "uncertaintyPenalty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard",
        "soft"
      ],
      "properties": {
        "hard": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "soft": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        }
      }
    },
    "freedoms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed",
        "open",
        "forbidden"
      ],
      "properties": {
        "fixed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "open": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "viewport",
          "colorScheme",
          "reducedMotion",
          "locale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "colorScheme": {
            "enum": [
              "light",
              "dark",
              "no-preference"
            ]
          },
          "reducedMotion": {
            "type": "boolean"
          },
          "locale": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "principles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow"
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceOfTruth",
        "missingPolicy",
        "claimsRequireEvidence"
      ],
      "properties": {
        "sourceOfTruth": {
          "type": "string"
        },
        "missingPolicy": {
          "enum": [
            "mark-todo",
            "fail",
            "use-approved-placeholder"
          ]
        },
        "claimsRequireEvidence": {
          "type": "boolean"
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actorId",
        "action",
        "object",
        "completionSignal"
      ],
      "properties": {
        "actorId": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "completionSignal": {
          "type": "string"
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "statement",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "statement",
        "control"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "statement": {
          "type": "string"
        },
        "control": {
          "type": "string"
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "class",
        "severity",
        "dimension",
        "stateRefs",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "note"
          ]
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "stateRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "automation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "metric",
            "operator",
            "expected"
          ],
          "properties": {
            "source": {
              "const": "playwright"
            },
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": [
                "eq",
                "neq",
                "lt",
                "lte",
                "gt",
                "gte",
                "contains"
              ]
            },
            "expected": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "value"
      ],
      "properties": {
        "by": {
          "enum": [
            "role",
            "label",
            "testId",
            "text",
            "css"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "exact": {
          "type": "boolean"
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "click",
            "fill",
            "select",
            "check",
            "uncheck",
            "press",
            "waitFor"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "value": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "workflowAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "visible",
            "hidden",
            "text",
            "url",
            "count",
            "checked",
            "value"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "expected": {
          "type": [
            "string",
            "integer",
            "boolean"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "actorId",
        "class",
        "severity",
        "dimension",
        "startStateRef",
        "steps",
        "assertions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "actorId": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "enum": [
            "A",
            "B"
          ]
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "note"
          ]
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "startStateRef": {
          "type": "string",
          "minLength": 1
        },
        "browsers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "chromium",
              "firefox",
              "webkit",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "obligationRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workflowStep"
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/workflowAssertion"
          }
        }
      }
    }
  }
}
